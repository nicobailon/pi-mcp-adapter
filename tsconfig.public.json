{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "stripInternal": true,
    "sourceMap": true
  },
  "include": [
    "config.ts",
    "metadata-cache.ts",
    "mcp-bearer-store.ts",
    "secure-keyring.ts",
    "jev-contracts.ts",
    "jev-key-store.ts",
    "jev-client.ts",
    "types.ts"
  ]
}
